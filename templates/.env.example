# Copie para .env (que NUNCA vai para o Git) e preencha. Documente cada variavel aqui.
# Padrao: SCREAMING_SNAKE_CASE com prefixo de dominio.

# --- Servidor ---
APP_NAME=nome-do-servico
APP_ENV=local            # local | development | staging | production
SERVER_PORT=8080

# --- Banco de dados ---
DB_URL=
DB_USER=
DB_PASSWORD=

# --- Observabilidade ---
LOG_LEVEL=INFO
ELASTIC_APM_SERVER_URL=  # vazio = APM desligado (obrigatorio no CI)
