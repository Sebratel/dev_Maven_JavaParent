<?xml version="1.0" encoding="UTF-8"?>
<!--
  sebratel-java-parent: ponto de partida de todo projeto Java/Spring Boot da Sebratel.

  Uso no pom do projeto:

      <parent>
          <groupId>br.com.sebratel</groupId>
          <artifactId>sebratel-java-parent</artifactId>
          <version>1.0.0</version>
          <relativePath/>
      </parent>

  O que ele impoe (resumo; detalhes no README):
    - Spring Boot 3.5.x e Java 21, com as versoes de seguranca fixadas abaixo
    - build falha se JDK < 21 ou Maven < 3.9 (maven-enforcer)
    - Lombok como annotation processor explicito (determinismo em qualquer JDK)
    - Checkstyle com as regras de sebratel-java-build-rules (fase verify)
    - JaCoCo com cobertura minima (fase verify), configuravel por projeto
    - profile -Psecurity com OWASP dependency-check (CVSS >= 7 quebra o build)
    - publicacao no GitHub Packages
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>br.com.sebratel</groupId>
    <artifactId>sebratel-java-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>sebratel-java-parent</name>
    <description>Parent POM dos projetos Java/Spring Boot da Sebratel</description>
    <url>https://github.com/Sebratel/dev_Maven_JavaParent</url>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          Lombok: o BOM do Spring Boot fixa uma versao que nao processa anotacoes em JDK 24+.
          Compile-only (optional) e excluido do JAR pelo spring-boot-maven-plugin.
        -->
        <lombok.version>1.18.42</lombok.version>

        <!--
          Overrides de seguranca alem do que o BOM do Spring Boot gerencia (CVSS >= 7 sem correcao
          incorporada ao BOM). Herdados de dev_SpringBoot_APIGateway. Revisar ao subir o parent do
          Spring Boot: provavelmente ficam redundantes.
        -->
        <netty.version>4.1.139.Final</netty.version>
        <postgresql.version>42.7.13</postgresql.version>
        <tomcat.version>10.1.59</tomcat.version>
        <log4j2.version>2.26.1</log4j2.version>
        <jackson-bom.version>2.22.3</jackson-bom.version>
        <logback.version>1.5.38</logback.version>

        <!-- Versoes de libs que nao estao no BOM do Spring Boot. -->
        <springdoc.version>2.8.17</springdoc.version>
        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>

        <!--
          Versao do sebratel-java-build-rules. NAO usar ${project.version} no lugar: o Maven avalia essa
          expressao no projeto FILHO, e a dependencia do plugin deixaria de resolver. Valor literal,
          atualizado junto com a versao do parent (release: versions:set-property).
        -->
        <sebratel-java-build-rules.version>1.0.0-SNAPSHOT</sebratel-java-build-rules.version>

        <!-- Plugins -->
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>10.21.4</checkstyle.version>
        <jacoco.version>0.8.13</jacoco.version>
        <dependency-check.version>12.1.3</dependency-check.version>

        <!-- Regras de qualidade ajustaveis por projeto (-D ou <properties> do filho). -->
        <!-- Cobertura minima de linhas (0.0 a 1.0). Projeto novo parte de 0.50; nunca abaixar sem registrar o motivo. -->
        <jacoco.minimum>0.50</jacoco.minimum>
        <!-- CVSS a partir do qual o profile "security" quebra o build. 7 = HIGH/CRITICAL. -->
        <dependency.check.failOnCvss>7</dependency.check.failOnCvss>
        <!-- Desliga o Checkstyle so em ultimo caso (ex.: migracao de codigo legado). -->
        <checkstyle.skip>false</checkstyle.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              Annotation processor explicito: a partir do JDK 23 o javac deixou de descobrir
              processors pelo classpath, e o Lombok simplesmente nao rodava ("cannot find symbol: log").
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Garante o mesmo JDK/Maven do CI e do Dockerfile (Temurin 21, Maven 3.9). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-sebratel-rules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>Projetos Sebratel exigem Java 21 ou superior.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                    <message>Projetos Sebratel exigem Maven 3.9+ (use ./mvnw).</message>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Regras de codigo: ver sebratel-java-build-rules/src/main/resources/sebratel/checkstyle.xml. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>br.com.sebratel</groupId>
                        <artifactId>sebratel-java-build-rules</artifactId>
                        <version>${sebratel-java-build-rules.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>sebratel/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                    <skip>${checkstyle.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>sebratel-checkstyle</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              JaCoCo 0.8.13: cobre class files ate Java 24 e continua compativel com o Temurin 21.
              Camadas sem logica propria ficam fora da conta, como no BFF.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/dto/**/*</exclude>
                        <exclude>**/model/**/*</exclude>
                        <exclude>**/entity/**/*</exclude>
                        <exclude>**/repository/**/*</exclude>
                        <exclude>**/*Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>sebratel-jacoco-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>sebratel-jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>sebratel-jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - Sebratel</name>
            <url>https://maven.pkg.github.com/Sebratel/dev_Maven_JavaParent</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages - Sebratel</name>
            <url>https://maven.pkg.github.com/Sebratel/dev_Maven_JavaParent</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <!--
          Profile de seguranca, acionado no CI com -Psecurity. Fora do build padrao porque a
          atualizacao da base do NVD e demorada.
          Uso:  ./mvnw -Psecurity verify -DskipTests
        -->
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.version}</version>
                        <configuration>
                            <failBuildOnCVSS>${dependency.check.failOnCvss}</failBuildOnCVSS>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                                <format>SARIF</format>
                            </formats>
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <!-- Credenciais do OSS Index vem do server "ossindex" no settings.xml, nunca aqui. -->
                            <ossIndexServerId>ossindex</ossIndexServerId>
                            <skipTestScope>true</skipTestScope>
                            <skipProvidedScope>false</skipProvidedScope>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
